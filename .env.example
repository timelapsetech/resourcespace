# Copy to .env and edit for this Mac.
# Docker Compose reads this file from the project root automatically.
# Do not commit a filled-in .env (it is gitignored).

# HTTP port on the host (container still listens on 80)
RS_HTTP_PORT=8089

# Proxies, manifests, web uploads (use an external drive on the long-term Mac)
FILESTORE_HOST_PATH=./data/filestore

# Stills tree — must exist and be allowed in Docker Desktop → File Sharing
# Quote paths that contain spaces. Prefer NFS over SMB for Docker bind mounts.
ORIGINALS_HOST_PATH="/Volumes/YourNAS/Your Share/Originals"

# Optional local sync/test folder (also mounted read-write)
SYNCDIR_HOST_PATH=./syncdir

# Host port for MariaDB (optional; for local DB clients). Container port stays 3306.
MYSQL_HOST_PORT=3309

# Optional: put MariaDB data on the same external drive.
# Leave unset / commented to use a Docker named volume.
# MYSQL_DATA_HOST_PATH=/Volumes/YourExternalDrive/resourcespace/mysql

# Documented for operators; PHP uses docker/config.php ($ollama_endpoint)
OLLAMA_ENDPOINT=http://192.168.x.x:11434
